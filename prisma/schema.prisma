generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String          @id @default(uuid())
  name          String
  email         String          @unique
  phone         String?
  address       String?
  city          String?
  state         String?
  zip           String?
  password      String?
  role          String          @default("agent") // 'agent' | 'admin'
  status        String          @default("active") // 'invited' | 'active'
  inviteToken   String?         @unique
  hireDate      DateTime        @default(now())
  licenseNumber String?
  licenseStatus String?
  licenseExpiration DateTime?
  lastVerifiedAt DateTime?
  mlsNumber     String?
  completions   Completion[]
  docAcks       DocAck[]
  supplyRequests SupplyRequest[]
  inventoryItems InventoryItem[]
  driversLicense String?         @db.Text
  autoInsurance  String?         @db.Text
}

model TrainingModule {
  id            String       @id @default(uuid())
  title         String
  videoUrl      String
  sequenceStage String       // 'day1', 'week1', 'month1'
  requiresAck   Boolean      @default(false)
  completions   Completion[]
}

model Completion {
  id          String         @id @default(uuid())
  userId      String
  moduleId    String
  completedAt DateTime       @default(now())
  ackAt       DateTime?
  user        User           @relation(fields: [userId], references: [id])
  module      TrainingModule @relation(fields: [moduleId], references: [id])
}

model Document {
  id          String   @id @default(uuid())
  title       String
  category    String
  fileUrl     String
  version     Int      @default(1)
  requiresAck Boolean  @default(true)
  updatedAt   DateTime @updatedAt
  docAcks     DocAck[]
}

model DocAck {
  id         String   @id @default(uuid())
  userId     String
  documentId String
  ackedAt    DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])
  document   Document @relation(fields: [documentId], references: [id])
}

model SupplyRequest {
  id              String   @id @default(uuid())
  userId          String
  itemType        String
  quantity        Int
  status          String    @default("requested") // 'requested', 'fulfilled', 'return_pending', 'returned'
  requestedAt     DateTime  @default(now())
  returnedAt      DateTime? // Populated when the admin confirms the return
  propertyAddress String?   // Optional for consumables, required for returnables
  user            User     @relation(fields: [userId], references: [id])
}

model InventoryItem {
  id         String   @id @default(uuid())
  userId     String
  itemType   String
  identifier String
  assignedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])
}

model Inquiry {
  id               String   @id @default(uuid())
  name             String
  email            String
  phone            String?
  currentBrokerage String?
  message          String
  status           String        @default("New") // 'New', 'Contacted', 'Interviewing', 'Hired', 'Declined Offer', 'Rejected'
  submittedAt      DateTime      @default(now())
  notes            InquiryNote[]
}

model InquiryNote {
  id        String   @id @default(uuid())
  inquiryId String
  text      String   @db.Text
  createdAt DateTime @default(now())
  inquiry   Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
}

model InventoryCatalog {
  id           String   @id @default(uuid())
  name         String   @unique
  cost         Float    @default(0.0)
  maxPerAgent  Int      @default(1)
  totalStock   Int      @default(0)
  isReturnable Boolean  @default(false)
  isActive     Boolean  @default(true)
}
